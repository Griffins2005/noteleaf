# Dependencies (reinstalled inside Docker)
**/node_modules/
**/.npm/

# Build outputs (rebuilt inside Docker)
**/.next/
**/dist/
**/out/
**/.turbo/

# Env files (injected via docker-compose.yml, never baked in)
**/.env
!**/.env.example
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production

# Version control
.git/
.gitignore

# Editor and OS artifacts
.DS_Store
.vscode/

# Test artifacts
**/coverage/

# Logs
*.log

# Docker files (already available to the daemon)
Dockerfile
docker-compose.yml
.dockerignore

# Docs
README.md
docs/
