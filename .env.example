# ─────────────────────────────────────────────────────────────────────────────
# Noteleaf — Docker Compose environment (copy to .env)
#
#   cp .env.example .env
#   docker compose up --build
#
# Web:  http://localhost:3003
# API:  http://localhost:3002
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=noteleaf
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=noteleaf

# ─── NVIDIA NIM (required for recap + Ask notes) ─────────────────────────────
NVIDIA_STT_MODE=cloud
NVIDIA_API_KEY=
NVIDIA_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa

# ─── Auth (required) ─────────────────────────────────────────────────────────
JWT_SECRET=generate_a_long_random_secret_before_deploy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (optional — OTP codes returned in API response if unset) ─────────
RESEND_API_KEY=
FROM_EMAIL=Noteleaf <onboarding@resend.dev>

# ─── Public URLs (set to your domain in production) ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3002
APP_URL=http://localhost:3003
API_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3003

# ─── Host ports ───────────────────────────────────────────────────────────────
WEB_PORT=3003
API_PORT=3002

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
