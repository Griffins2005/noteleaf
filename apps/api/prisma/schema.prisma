// ─────────────────────────────────────────────────────────────────────────────
// Noteleaf — Prisma Schema
//
// Database: PostgreSQL
// ORM: Prisma 6
//
// Design decisions:
//   - Sessions are partitioned by userUuid (not a foreign key to a users table)
//     because Noteleaf uses UUID-based identity — there is no auth system.
//   - Notes are stored inline as JSON in the Session record to avoid the
//     overhead of joining a separate notes table on every session load.
//     This is appropriate because notes are always loaded with their session.
//   - AiSummary has its own table to allow lazy loading — the summary is only
//     fetched when the user views a summarised session or requests regeneration.
//
// @map annotations: the init migration was hand-written with snake_case column
// names. @map is required wherever the Prisma field name (camelCase) differs
// from the database column name (snake_case).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Session ─────────────────────────────────────────────────────────────────

model Session {
  /// UUID v4. Generated by the client before the recording starts.
  id               String        @id @db.Uuid

  /// The UUID of the user who owns this session. Indexed for fast lookup.
  /// No foreign key — user identity is UUID-only, no users table.
  userUuid         String        @db.Uuid               @map("user_uuid")

  /// User-provided session title. Defaults to empty string.
  title            String        @default("")

  /// All captured notes stored as a JSON array.
  /// Shape: Note[] from @noteleaf/shared-types
  notes            Json          @default("[]")

  /// Full concatenated raw transcript from all NVIDIA NIM final transcript events.
  transcript       String        @default("")

  /// Timestamped final transcript segments.
  /// Shape: TranscriptSegment[] from @noteleaf/shared-types
  /// Column name is camelCase — added by the second migration without @map.
  transcriptSegments Json        @default("[]")

  /// Total recording duration in seconds. Set when session status → stopped.
  durationSeconds  Int           @default(0)             @map("duration_seconds")

  /// Lifecycle state of the session.
  status           SessionStatus @default(IDLE)

  /// Timestamps managed by Prisma.
  createdAt        DateTime      @default(now())         @map("created_at")
  updatedAt        DateTime      @updatedAt              @map("updated_at")

  /// One-to-one relationship with AiSummary. Nullable — only set after user
  /// explicitly requests AI summarisation.
  aiSummary        AiSummary?

  @@index([userUuid])
  @@index([userUuid, updatedAt(sort: Desc)])
  @@map("sessions")
}

enum SessionStatus {
  IDLE
  RECORDING
  STOPPED
  SUMMARISED

  @@map("session_status")
}

// ─── User email recovery ──────────────────────────────────────────────────────

model UserEmail {
  /// The verified email address — primary key (one email → one UUID).
  email     String   @id

  /// The UUID this email is linked to (many emails can share one UUID).
  userUuid  String   @db.Uuid  @map("user_uuid")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userUuid])
  @@map("user_emails")
}

// ─── AI Summary ──────────────────────────────────────────────────────────────

model AiSummary {
  /// UUID v4. Generated by the API at creation time.
  id          String   @id @db.Uuid

  /// Foreign key back to the session this summarises.
  sessionId   String   @unique @db.Uuid                 @map("session_id")
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// High-level overview of the meeting.
  overview    String

  /// JSON array of decision strings.
  decisions   Json     @default("[]")

  /// JSON array of action item strings.
  actionItems Json     @default("[]")                   @map("action_items")

  /// JSON array of insight strings.
  insights    Json     @default("[]")

  /// The NVIDIA model used to generate this summary. Stored for auditing.
  modelUsed   String                                    @map("model_used")

  createdAt   DateTime @default(now())                  @map("created_at")

  @@map("ai_summaries")
}
