// ─────────────────────────────────────────────────────────────────────────────
// Noteleaf — Prisma Schema
//
// Database: PostgreSQL
// ORM: Prisma 6
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @db.Uuid
  email         String?  @unique
  name          String?
  avatar        String?
  googleId      String?  @unique @map("google_id")
  retentionDays Int?     @map("retention_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  sessions      Session[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ─── Session ─────────────────────────────────────────────────────────────────

model Session {
  id                 String        @id @db.Uuid
  userUuid           String        @db.Uuid               @map("user_uuid")
  user               User          @relation(fields: [userUuid], references: [id], onDelete: Cascade)

  title              String        @default("")
  notes              Json          @default("[]")
  transcript         String        @default("")
  transcriptSegments Json          @default("[]")
  chatMessages       Json          @default("[]")         @map("chat_messages")
  durationSeconds    Int           @default(0)            @map("duration_seconds")
  status             SessionStatus @default(IDLE)

  createdAt          DateTime      @default(now())        @map("created_at")
  updatedAt          DateTime      @updatedAt             @map("updated_at")

  aiSummary          AiSummary?

  @@index([userUuid])
  @@index([userUuid, updatedAt(sort: Desc)])
  @@map("sessions")
}

enum SessionStatus {
  IDLE
  RECORDING
  STOPPED
  SUMMARISED

  @@map("session_status")
}

// ─── User email recovery ──────────────────────────────────────────────────────

model UserEmail {
  email     String   @id
  userUuid  String   @db.Uuid  @map("user_uuid")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userUuid])
  @@map("user_emails")
}

// ─── AI Summary ──────────────────────────────────────────────────────────────

model AiSummary {
  id          String   @id @db.Uuid
  sessionId   String   @unique @db.Uuid                 @map("session_id")
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  overview    String
  decisions   Json     @default("[]")
  actionItems Json     @default("[]")                   @map("action_items")
  insights    Json     @default("[]")
  modelUsed   String                                    @map("model_used")

  createdAt   DateTime @default(now())                  @map("created_at")

  @@map("ai_summaries")
}

// ─── OTP code ─────────────────────────────────────────────────────────────────
// Persists email sign-in codes so they survive server restarts and work across
// multiple API instances. codeHash is SHA-256(email:code:JWT_SECRET).

model OtpCode {
  id        String    @id @db.Uuid
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt(sort: Desc)])
  @@map("otp_codes")
}

// ─── Refresh token ────────────────────────────────────────────────────────────
// Enables access token renewal without re-login. tokenHash is SHA-256 of the
// random opaque token sent to the client. Tokens are rotated on every use.

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid  @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
