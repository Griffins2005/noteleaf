{
  "name": "@noteleaf/api",
  "version": "1.0.0",
  "private": true,
  "description": "Noteleaf backend API — Fastify server with NVIDIA NIM STT proxy and NVIDIA NIM AI summarisation",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@noteleaf/shared-types": "*",
    "@prisma/client": "6.19.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.3",
    "openai": "^6.37.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.12.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/uuid": "^11.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  }
}
