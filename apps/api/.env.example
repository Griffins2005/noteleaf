# ─────────────────────────────────────────────────────────────────────────────
# Noteleaf API — Environment Variables
#
# For local development (outside Docker):
#   cp apps/api/.env.example apps/api/.env
#   Fill in DATABASE_URL and NVIDIA_API_KEY then run: npm run dev
#
# For Docker: variables are injected by docker-compose.yml from the root .env.
# You do not need to edit this file when using Docker.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noteleaf

# ─── NVIDIA NIM ───────────────────────────────────────────────────────────────
# Free API key from https://build.nvidia.com (no credit card required).
# Used for:
#   • AI meeting summary  → nvidia/nemotron-3-super-120b-a12b
#   • Ask my notes chat   → same model
#   • Cloud STT mode      → NVIDIA Riva ASR gRPC (if NVIDIA_STT_MODE=cloud)
NVIDIA_API_KEY=nvapi-your_key_here

# Speech-to-text mode.
#   cloud       → NVIDIA Build managed endpoint (default, requires API key)
#   self-hosted → local NIM container running on your GPU
NVIDIA_STT_MODE=cloud

# Cloud Function ID for the Nemotron ASR Streaming model (stable as of 2025).
NVIDIA_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa

# Self-hosted NIM — ignored in cloud mode.
# Run the NIM container on your GPU:
#   docker run --runtime=nvidia --gpus '"device=0"' \
#     -e NGC_API_KEY -e NIM_TAGS_SELECTOR=mode=str \
#     -e NIM_GRPC_API_PORT=50051 -p 50051:50051 \
#     nvcr.io/nim/nvidia/nemotron-asr-streaming:latest
NVIDIA_NIM_HOST=localhost
NVIDIA_NIM_GRPC_PORT=50051

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Powers the cross-device UUID recovery feature.
# Get a free key at https://resend.com (3 000 emails/month free).
#
# When blank: verification codes are returned in the API response body
# (devCode field) so you can test without an email provider.
RESEND_API_KEY=

# Sender address for recovery emails.
# Must be verified in your Resend dashboard for production use.
# The default onboarding@resend.dev address works for initial testing.
FROM_EMAIL=Noteleaf <onboarding@resend.dev>

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the API allows.
# In development this is the Next.js dev server.
# In production, set this to your actual frontend domain.
ALLOWED_ORIGINS=http://localhost:3003

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
# REQUIRED in production — the fallback is intentionally insecure.
JWT_SECRET=change_me_to_a_long_random_string_in_production

# Google OAuth 2.0 credentials (optional — email OTP works without these).
# 1. Create OAuth 2.0 credentials in Google Cloud Console
# 2. Add authorized redirect URI: ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public-facing URLs used by the API for OAuth redirects.
# In Docker these are set by docker-compose.yml.
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
