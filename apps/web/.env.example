# ─────────────────────────────────────────────────────────────────────────────
# Noteleaf Web — Environment Variables
#
# For local development (outside Docker):
#   cp apps/web/.env.example apps/web/.env.local
#   The defaults work immediately — no changes required unless you moved ports.
#
# For Docker: variables are injected by docker-compose.yml from the root .env.
# You do not need this file when using Docker.
#
# NEXT_PUBLIC_* variables are embedded in the client JS bundle at build time.
# Server-only variables (no prefix) are available to Next.js API routes and
# Server Components only — not visible in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API URL ──────────────────────────────────────────────────────────────────
# Base URL the BROWSER uses to reach the Noteleaf Fastify API.
# This is baked into the client bundle at build time.
#
# Local dev (outside Docker):  http://localhost:3001
# Docker (same machine):       http://localhost:3002  (the published host port)
# Production:                  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── App metadata ─────────────────────────────────────────────────────────────
# Public-facing URL of the web app. Used in metadata and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Dev tools ────────────────────────────────────────────────────────────────
# Set to "true" to show the React Query Devtools panel in development.
# Has no effect when NODE_ENV=production.
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true
