# ─────────────────────────────────────────────────────────────────────────────
# Noteleaf Web — local development (without Docker)
#
#   cp apps/web/.env.example apps/web/.env.local
#   npm run dev
#
# With Docker Compose, these are set via build args in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# Browser-visible API URL (must match where the API is reachable from your machine)
NEXT_PUBLIC_API_URL=http://localhost:3002

# App URL (metadata, OAuth redirects when running web standalone)
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Optional: override WebSocket URL for server-side STT mode
# NEXT_PUBLIC_WS_URL=ws://localhost:3002/api/stt/stream

# Server-side only — Next.js rewrites /api/* to this target (npm run dev outside Docker)
API_INTERNAL_URL=http://localhost:3001
