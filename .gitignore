# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/
build/

# Turbo / TypeScript cache
.turbo/
*.tsbuildinfo

# Environment — never commit secrets (.env.example files are tracked)
.env
.env.local
.env.*.local
.env.development
.env.production
apps/api/.env
apps/web/.env.local

# Explicitly track env templates
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# OS
.DS_Store
Thumbs.db

# Keys / certs
*.pem

# Editors (personal settings only; keep shared config if added later)
.vscode/settings.json
.idea/

# Local AI / agent tooling
.claude

# Prisma local SQLite (not used in production, but ignore if created)
*.db
*.db-journal
